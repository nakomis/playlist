<mxfile host="Claude">
  <diagram id="playlist" name="Playlist">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="700" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="mac" value="Mac" style="swimlane;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="240" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="chrome" value="Chrome&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Playlist web UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="mac">
          <mxGeometry x="40" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="phones" value="Swimming headphones&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;USB mass storage&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="mac">
          <mxGeometry x="40" y="160" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="File System Access API&lt;br&gt;MP3s written in play order" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="mac" source="chrome" target="phones">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="claude" value="Claude sessions&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;via meta-mcp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="leia" value="Leia" style="swimlane;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="260" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="nginx" value="nginx, mTLS gate&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;playlist.home.nakomis.com&lt;br&gt;MCP endpoint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="leia">
          <mxGeometry x="40" y="40" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="plex" value="Plex Media Server&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Music (CC) / Purchased&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="leia">
          <mxGeometry x="40" y="170" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="nas" value="NAS: /mnt/data/plex&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;music/, purchased/ (L&amp;amp;L)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#ffffff;" vertex="1" parent="leia">
          <mxGeometry x="40" y="280" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="leia" source="plex" target="nas">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mace" value="Mace (Docker Compose, Ansible)" style="swimlane;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="400" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="Web API :8000&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;FastAPI + built UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="mace">
          <mxGeometry x="20" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mcp" value="MCP :8001&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;streamable HTTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="mace">
          <mxGeometry x="220" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="Mix worker&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;planner, renderer&lt;br&gt;ffmpeg + Rubber Band&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="mace">
          <mxGeometry x="120" y="140" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="analyser" value="Library sync + analyser&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tempo, beat grid, key, loudness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="mace">
          <mxGeometry x="20" y="260" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="data" value="/data volume&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SQLite cache, mixes (7 days)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#ffffff;" vertex="1" parent="mace">
          <mxGeometry x="230" y="250" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="mace" source="api" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="mace" source="mcp" target="worker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="mace" source="worker" target="data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="mace" source="analyser" target="data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="HTTPS + client cert" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="chrome" target="nginx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="MCP + client cert" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="claude" target="nginx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="385"/>
              <mxPoint x="300" y="130"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="nginx" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="nginx" target="mcp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="30"/>
              <mxPoint x="960" y="30"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="titles, genres, paths" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="analyser" target="plex">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="315"/>
              <mxPoint x="620" y="240"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="audio (read-only mount)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="analyser" target="nas">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
